# Application runtime
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mock-test-platform

# JWT secrets: use unique, securely generated values (minimum 16 characters).
JWT_ACCESS_SECRET=replace-with-a-secure-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Browser/API configuration
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
